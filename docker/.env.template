# =============================================================================
# 筑云 BuildCloud — 本地中间件环境变量模板（W1 Phase 1）
# 用法：cp .env.template .env 后按需修改；.env 已被 .gitignore 忽略，绝不提交（AGENTS.md R-1）
# 以下均为占位值（ChangeMe_*），首次使用前请全部替换成自己的本地值
# =============================================================================

COMPOSE_PROJECT_NAME=buildcloud
TZ=Asia/Shanghai

## ---- MySQL 8.4（业务库 ruoyi-vue-pro + 分片库 pm_log_0..3 + xxl_job）----
MYSQL_ROOT_PASSWORD=ChangeMe_Mysql_Root_2026
MYSQL_DATABASE=ruoyi-vue-pro
MYSQL_USER=yudao
MYSQL_PASSWORD=ChangeMe_Mysql_Yudao_2026
# XXL-Job 调度中心专用数据库账号（02-grants.sh 自动创建并授权）
XXL_JOB_DB_USER=xxl_job
XXL_JOB_DB_PASSWORD=ChangeMe_Mysql_Xxljob_2026
# 本机默认 13306（与基座官方 compose 对「本机 3306 已被占用」的建议一致）：
# 2026-11-25 实测本机 mysqld 服务占用 3306，故 Docker 侧用 13306；
# 若本机 3306 空闲且希望与基座 application-dev.yaml 默认一致，可改回 3306
MYSQL_HOST_PORT=13306

## ---- Redis 7.4 ----
REDIS_PASSWORD=ChangeMe_Redis_2026
# 本机默认 16379（基座官方 compose 对「本机 6379 已被占用」的建议备用端口）：
# 2026-11-25 实测本机已有 redis-server 占用 6379；Phase 2 服务侧经 application-local.yaml
# 指向 127.0.0.1:16379；若本机 6379 空闲可改回 6379
REDIS_HOST_PORT=16379

## ---- Nacos 3.0.3（本地单机、未开鉴权，端口仅绑定 127.0.0.1）----
# v3 入口脚本强制要求以下三项（即使 NACOS_AUTH_ENABLE=false 也必须填写）：
# NACOS_AUTH_TOKEN = 32 字节以上字符串的 Base64（下方为占位示例，可自行重新生成）
NACOS_AUTH_TOKEN=YnVpbGRjbG91ZC1sb2NhbC1uYWNvcy10b2tlbi1jaGFuZ2UtbWU=
NACOS_AUTH_IDENTITY_KEY=buildcloud-identity
NACOS_AUTH_IDENTITY_VALUE=ChangeMe_Nacos_Identity_2026
NACOS_HTTP_HOST_PORT=8848
NACOS_GRPC_HOST_PORT=9848
NACOS_CONSOLE_HOST_PORT=8080

## ---- RocketMQ 5.3.1 ----
RMQ_NAMESRV_HOST_PORT=9876
RMQ_BROKER_HOST_PORT=10911

## ---- Seata Server 2.5.0（AT 模式 / file 存储）----
SEATA_HOST_PORT=8091
SEATA_CONSOLE_HOST_PORT=7091

## ---- XXL-Job-Admin 2.4.0（容器内 8080 → 宿主机 9090，与基座 dev 配置对齐）----
XXL_JOB_HOST_PORT=9090
# 执行器/调度中心通行令牌（基座 W2 接入时需与此保持一致）
XXL_JOB_ACCESS_TOKEN=ChangeMe_Xxljob_Token_2026

## ---- MinIO（quay.io 官方镜像；Docker Hub 已下架）----
MINIO_ROOT_USER=buildcloud
MINIO_ROOT_PASSWORD=ChangeMe_Minio_2026
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

## ---- PostgreSQL 17 + pgvector 0.8.7（W7 AI/RAG 向量库）----
POSTGRES_USER=buildcloud
POSTGRES_PASSWORD=ChangeMe_Pg_2026
POSTGRES_DB=buildcloud_ai
PG_HOST_PORT=5432
