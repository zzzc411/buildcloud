<?xml version="1.0" encoding="UTF-8"?>
<!--
  筑云 BuildCloud —— 立项审批流程（project-approve）BPMN 2.0 流程定义源文件

  用途：由 scripts/bpm-deploy-project-approve.ps1 读取并调 bpm-server 的
        POST /admin-api/bpm/model/create（BPMN 设计器模型）→ POST /admin-api/bpm/model/deploy
        部署为 Flowable 流程定义。本文件是**单一事实来源**，改流程只改这里再重跑脚本。

  流程结构（spec v1.2 §5.3：提交 → 部门经理审批 → 通过/驳回两条出线）：
    发起（start 事件）
      → 部门经理审批（userTask id=managerApprove，候选审批人=用户组 9201 项目经理组）
          ├─ 通过 → 结束（end 事件）：bpm-server 判定实例 STATUS=APPROVE → 回调业务方 → 项目 筹备→在建
          └─ 驳回 → 结束（end 事件）：bpm-server 判定实例 STATUS=REJECT  → 回调业务方 → 项目保持筹备

  关键约定（均来自基座源码，勿凭记忆修改）：
  1. 流程 key/name 必须与流程模型（ACT_RE_MODEL）的 key/name 完全一致，否则
     BpmProcessDefinitionServiceImpl#createProcessDefinition 抛 PROCESS_DEFINITION_KEY/NOT_MATCH；
  2. 审批人配置用扩展元素 flowable:candidateStrategy / flowable:candidateParam
     （BpmnModelUtils#parseCandidateStrategy 先读属性、读不到再读扩展元素——两者都支持，
      这里按 SIMPLE 设计器产物用扩展元素，兼容两种读取路径）；
     candidateStrategy=40 即 BpmTaskCandidateStrategyEnum.USER_GROUP，candidateParam=9201 是
     sql/buildcloud/05-bpm-seed.sql 的「项目经理组」用户组编号；
  3. 驳回策略不配 rejectHandlerType ⇒ 走默认「终止型驳回」
     （BpmTaskServiceImpl#rejectTask 3.2：实例变量 STATUS=REJECT + moveTaskToEnd 结束流程），
     这正是本项目需要的「驳回即终止、业务方收到 REJECT(3) 回调」语义；
  4. **只有一个结束事件、审批节点直连结束（不要用排他网关）**——W3-P4 实测踩坑：
     初版写成 managerApprove → exclusiveGateway → 单条带 `CDATA[${true}]` 条件的出线 → end，
     部署时 Flowable 校验器直接拒绝：
       Validation set 'flowable-executable-process'
       | Problem 'flowable-exclusive-gateway-condition-not-allowed-on-single-seq-flow'
       | Exclusive gateway has only one outgoing sequence flow. This is not allowed to have a condition.
     即「单出线的排他网关不允许带条件表达式」。而本项目两条出线并非由网关条件区分：
     - **通过**由 BpmTaskServiceImpl#approveTask 调 taskService.complete 完成，任务正常流出到结束事件；
     - **驳回**由 rejectTask 里 moveTaskToEnd 直接把任务搬到 EndEvent（BpmnModelUtils#getEndEvent
       取流程里**第一个** EndEvent），不走网关。
     所以网关对两条路径都没有实际作用，去掉它最简、也最少踩引擎校验。留一个 EndEvent 还能保证
     moveTaskToEnd 取到的结束事件确定唯一，不会因元素顺序变化而行为漂移。

  流程变量（由 buildcloud-project 发起时传入，见 ProjectApprovalServiceImpl）：
    businessKey   = 项目 id（写在 ACT_HI_PROCINST.BUSINESS_KEY_，回调时原样带回）
    projectId / projectNo / projectName / initiator / deptId
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://bpm.buildcloud.com/definition">
    <process id="project-approve" name="立项审批" isExecutable="true">
        <documentation>工程项目立项审批：部门经理审批，通过后项目状态由「筹备」转为「在建」，驳回则保持「筹备」。</documentation>

        <startEvent id="StartEvent" name="发起立项申请"/>

        <!-- 部门经理审批：候选人为「项目经理组」（用户组编号 9201） -->
        <userTask id="managerApprove" name="部门经理审批" flowable:candidateStrategy="40" flowable:candidateParam="9201">
            <extensionElements>
                <flowable:candidateStrategy>40</flowable:candidateStrategy>
                <flowable:candidateParam>9201</flowable:candidateParam>
            </extensionElements>
        </userTask>

        <!-- 审批通过后直接结束（不用排他网关：单出线带条件会被 Flowable 校验拒绝，见文件头第 4 条） -->
        <endEvent id="EndEventApprove" name="审批通过"/>

        <sequenceFlow id="flowStart" sourceRef="StartEvent" targetRef="managerApprove"/>
        <sequenceFlow id="flowApprove" sourceRef="managerApprove" targetRef="EndEventApprove"/>
    </process>

    <!-- 流程图元数据：管理端「流程模型」预览用（无 BPMNDI 会导致设计器打开空白画布） -->
    <bpmndi:BPMNDiagram id="BPMNDiagram_project-approve">
        <bpmndi:BPMNPlane bpmnElement="project-approve" id="BPMNPlane_project-approve">
            <bpmndi:BPMNShape bpmnElement="StartEvent" id="BPMNShape_StartEvent">
                <omgdc:Bounds height="36.0" width="36.0" x="100.0" y="163.0"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="managerApprove" id="BPMNShape_managerApprove">
                <omgdc:Bounds height="80.0" width="100.0" x="186.0" y="141.0"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="EndEventApprove" id="BPMNShape_EndEventApprove">
                <omgdc:Bounds height="36.0" width="36.0" x="426.0" y="163.0"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge bpmnElement="flowStart" id="BPMNEdge_flowStart">
                <omgdi:waypoint x="136.0" y="181.0"/>
                <omgdi:waypoint x="186.0" y="181.0"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flowApprove" id="BPMNEdge_flowApprove">
                <omgdi:waypoint x="286.0" y="181.0"/>
                <omgdi:waypoint x="426.0" y="181.0"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</definitions>
